# ==============================================================================
# Cynbit AI Project Blueprint - Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env or secrets.

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# If omitted, leads will fall back to local dev logging or serverless console logging.
MONGODB_URI=

# Rate Limiting Secret Salt (used to hash client IP before storing in MongoDB TTL collection)
RATE_LIMIT_SALT=replace-with-a-random-secret-salt-for-ip-hashing

# LLM Configuration (Provider, Model, API Key)
# Supported LLM_PROVIDER: "openai" | "groq" | "openrouter" | "mock"
# Default fallback provider if empty: "openai"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional LLM Base URL (e.g. for Groq: https://api.groq.com/openai/v1 or OpenRouter)
LLM_BASE_URL=

# App Base URL (used for absolute metadata and canonical tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000
