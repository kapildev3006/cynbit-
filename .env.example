# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cynbit?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cynbit?retryWrites=true&w=majority"

# JWT Secret for Session Cookies (Generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-character-secret-minimum"

# Initial Admin Credentials (Used by `npm run seed`)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-secure-admin-password"

# Optional Team Member Credentials for Role Testing
SEED_MEMBER_EMAIL="member@example.com"
SEED_MEMBER_PASSWORD="replace-with-a-secure-member-password"

# Secret Salt for Rate Limiting IP Hashes (Generate with: openssl rand -hex 16)
RATE_LIMIT_SALT="replace-with-a-random-hex-salt"

# Canonical Public Site URL (e.g., http://localhost:3000 or https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
